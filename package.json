{
  "name": "bigred-link",
  "version": "2.0.0-beta.6",
  "description": "A big red URL shortener",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">= 24.x",
    "npm": ">= 11.x"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "back-up-db": "npx tsx ./src/scripts/back-up-db.ts",
    "build": "npx tsc -b && npx vite build",
    "check-all-urls": "npx tsx ./src/scripts/safe-browsing-url-check.ts",
    "clean": "rm -rf ./build",
    "dev:vite": "npx vite serve --port $PORT",
    "format": "npx oxfmt src",
    "format:check": "npx oxfmt --check src",
    "lint": "npx oxlint .",
    "prebuild": "npm run clean",
    "preview": "npx vite preview",
    "start": "npx vercel dev --listen 3001",
    "test": "npm run format:check && npm run lint && npm run typecheck",
    "typecheck": "npx tsc --noEmit"
  },
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "homepage": "https://bigred.link",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mikesprague/bigred-link"
  },
  "bugs": {
    "url": "https://github.com/mikesprague/bigred-link/issues"
  },
  "dependencies": {
    "@bugsnag/core": "9.0.0",
    "@bugsnag/js": "9.0.0",
    "@bugsnag/plugin-react": "9.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tursodatabase/serverless": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.16",
    "dotenv": "18.0.5",
    "jotai": "3.0.1",
    "lucide-react": "1.48.0",
    "nanoid": "6.0.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "tailwind-merge": "3.7.0",
    "tldts": "7.4.16",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cz-git": "1.14.0",
    "globals": "17.13.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "vercel": "62.1.0",
    "vite": "8.3.2",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "overrides": {
    "@bugsnag/core": "9.0.0",
    "@hono/node-server": "^2.1.1",
    "@tootallnate/once": "^3.0.1",
    "ajv": "^8.20.0",
    "brace-expansion": "^5.0.12",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.2",
    "minimatch": "^10.2.6",
    "path-to-regexp": "^8.4.2",
    "smol-toml": "^1.9.0",
    "tar": "^7.5.22",
    "undici": "^8.11.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild": true
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  }
}
